# Secrets — never commit
.env
.env.*
!.env.example

# IDE — never commit
.idea/
.vscode/
*.swp
.DS_Store

# Dependencies & build output — never commit
node_modules/
dist/
coverage/
*.tsbuildinfo
.turbo/
.next/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Application projects (other than the tracked sample) — never commit private bots here
projects/*
!projects/README.md
!projects/.gitignore
# Public sample shipped with the OSS repo (port 9998)
!projects/sample-landing-llm/
!projects/sample-landing-llm/**

# Local-only leftovers (legacy PoCs / SpecKit dumps) — never track
archive/

# uv / SpecKit local tool shims (machine-absolute symlinks)
.uv-bin/
.uv-tools/
node_modules

# Local make orchestration (promote from Makefile.stub) — OSS sample only
Makefile
!Makefile.stub
