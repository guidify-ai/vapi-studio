# Secrets — never commit
.env
.env.*
!.env.example

# IDE — never commit
.idea/
.vscode/
*.swp
.DS_Store

# Dependencies & build output — never commit
node_modules/
dist/
coverage/
*.tsbuildinfo
.turbo/
.next/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Application projects (content gitignored; README + .gitignore tracked)
projects/*
!projects/README.md
!projects/.gitignore
# Tracked in-repo Vapi Studio sample (port 9998 — same surface as PoCs)
!projects/sample-landing-llm/
!projects/sample-landing-llm/**
# Private experiments — never track (belt + suspenders vs projects/*)
projects/roofr-poc/
projects/roofr-poc/**
# Marketing landing (:4173) and other private apps stay gitignored

# Local-only leftovers (legacy PoCs / SpecKit dumps) — never track
archive/

# uv / SpecKit local tool shims (machine-absolute symlinks)
.uv-bin/
.uv-tools/
