# Framework / consumer shared presets for @guidify-ai/vapi-studio
# Copy to your Nest app as `.env` (gitignored). Leave secret values empty.
# Brain *adapter choice* is usually code (`VapiStudioModule.forRoot` / brain.config.ts);
# keys below are what stock adapters read from the environment.

# ─── Brain providers (pick one live adapter in code; set only that key) ───
# ChatGPT  → ChatGptBrainAdapter      (adapter id: studio-chatgpt)
OPENAI_API_KEY=
# Claude   → ClaudeBrainAdapter       (adapter id: studio-claude)
ANTHROPIC_API_KEY=
# Gemini   → GeminiBrainAdapter       (adapter id: studio-gemini)
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias for GOOGLE_API_KEY
# Grok     → GrokBrainAdapter         (adapter id: studio-grok)
XAI_API_KEY=
# Mock adapters (mock / mock-chatgpt / mock-claude / mock-gemini / mock-grok) need no keys.

# Optional: profile stamp on Conversation bootstrap (app-defined string)
# POC_BRAIN_PROFILE=default

# ─── Logging / console forensics ───
STUDIO_CONSOLE_DEBUG=1
# STUDIO_CONSOLE_DEBUG_ALL=0
STUDIO_FILE_LOG=1
LOG_DIR=logs
LOG_DAYS=14

# ─── Forms ───
# STUDIO_FORM_ACK_MS=15000

# ─── Twilio (REQUIRED for live voice — Twilio only for now) ───
# Dry-run SMS by default (TWILIO_SMS_DRY_RUN=1). Voice outbound goes through Vapi
# using a number imported from THIS Twilio account. Trust Hub must allow +1;
# keep ~$30 balance (auto-recharge to $30 near $10 recommended).
# Other carriers (Telnyx/Vonage/…) — later; Vapi already supports more.
TWILIO_SMS_DRY_RUN=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER_SID=

# ─── Vapi Custom LLM / tools (names must match the assistant in the Vapi dashboard) ───
VAPI_END_CALL_TOOL_NAME=end_call_tool
VAPI_TRANSFER_CALL_TOOL_NAME=transferCall
VAPI_HANDOFF_TOOL_NAME=handoff
VAPI_TRANSFER_DESTINATION=
# VAPI_SILENCE_TIMEOUT_SECONDS=120
# VAPI_WEBHOOK_SECRET=
# VAPI_DASHBOARD_CALL_URL=https://dashboard.vapi.ai/call/{callId}

# ─── App identity / ingress (your Nest app — not regenerated at runtime) ───
# Source of truth: config/project.identity.json (name + slug from PROJECT_NAME)
# PROJECT_NAME=
# PROJECT_SLUG=
# PUBLIC_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app
# PORT=9999
# DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio
# CONFIG_DIR=config

# ─── Vapi telephony (REQUIRED for live voice — empty means must fill in app .env) ───
# Client must have Vapi org access. Number is Twilio-imported (see Twilio block).
# Vapi is a paid service — expect usage/plan charges there in addition to Twilio.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
VAPI_PHONE_NUMBER_READABLE=
POC_ASSISTANT_ID=
# POC_ASSISTANT_ID_AB=

# ─── Guidify ecosystem auth (one keyring to rule them all) ───
# Vapi Studio — and every sibling service in the Guidify constellation — speaks a
# single authorization dialect: present these Application credentials to the
# tenants service, receive a short-lived JWT, and that token unlocks only the
# surfaces your Application is entitled to (analytics:write, telephony, …).
# Mint client_id / client_secret in ecosystem-tenants; leave empty until then.
# VAPI_STUDIO_CLIENT_ID=
# VAPI_STUDIO_CLIENT_SECRET=

# ─── Event broker (app-owned; same pattern as Postgres — optional Redis fan-out) ───
# Framework emits in-process only. Bridge with onStudioEvent → Redis / queue / warehouse.
# See docs/guides/extending-events.md and docs/guides/docker-compose.events.stub.yaml
# STUDIO_EVENTS_REDIS_URL=redis://127.0.0.1:16380
# STUDIO_EVENTS_REDIS_STREAM=studio:events
# EVENT_STORE_DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/app_events
