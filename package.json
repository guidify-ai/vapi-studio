{
  "name": "@guidify-ai/vapi-studio",
  "version": "0.1.1",
  "description": "Vapi Studio — deterministic voice agents for Vapi (NestJS)",
  "license": "MIT",
  "keywords": [
    "chat",
    "chat-application",
    "chatbot",
    "chatbots",
    "vapi",
    "vapi-ai",
    "vapi-alternative",
    "vapi-tools",
    "voice-agent",
    "voice-ai",
    "voice-assistant",
    "voice-chat",
    "voip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidify-ai/vapi-studio.git"
  },
  "homepage": "https://github.com/guidify-ai/vapi-studio#readme",
  "bugs": {
    "url": "https://github.com/guidify-ai/vapi-studio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./docs/best-practices/*": "./docs/best-practices/*",
    "./agent/AGENTS.md": "./agent/AGENTS.md"
  },
  "files": [
    "dist",
    "docs",
    "agent",
    "scripts",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && yarn build:studio-ui",
    "build:studio-ui": "yarn --cwd studio-ui install && yarn --cwd studio-ui build",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "yarn lint && yarn build && node --test test/*.test.mjs",
    "postinstall": "node -e \"const fs=require('fs');const p=require('path');const s=p.join(__dirname,'scripts','install-agent-refs.cjs');if(fs.existsSync(s)) require('child_process').execFileSync(process.execPath,[s],{stdio:'inherit',env:process.env});\"",
    "install-agent-refs": "node scripts/install-agent-refs.cjs"
  },
  "dependencies": {
    "uuid": "11.1.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/typeorm": "11.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "twilio": "5.4.5"
  },
  "peerDependenciesMeta": {
    "twilio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/typeorm": "11.0.3",
    "@types/node": "22.13.10",
    "@types/uuid": "10.0.0",
    "eslint": "10.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-morph": "28.0.0",
    "typeorm": "0.3.31",
    "typescript": "5.8.2",
    "typescript-eslint": "8.69.0"
  }
}
