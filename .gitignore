# Secrets — never commit
.env
.env.*
!.env.example

# IDE — never commit
.idea/
.vscode/
*.swp
.DS_Store

# Dependencies & build output — never commit
node_modules/
dist/
coverage/
*.tsbuildinfo
.turbo/
.next/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local-only leftovers (legacy PoCs / SpecKit dumps) — never track
archive/

# uv / SpecKit local tool shims (machine-absolute symlinks)
.uv-bin/
.uv-tools/

# Local make orchestration (promote from Makefile.stub)
Makefile
!Makefile.stub
