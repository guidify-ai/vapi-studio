# Makefile.stub — tracked template for OSS sample orchestration.
#
# Promote once (gitignored local file):
#   cp Makefile.stub Makefile
#
# Full Roofr + ecosystem stack lives in sibling ~/work/guidify-lab (private).

.PHONY: help promote build start stop reset start-vapi-studio

ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

help:
	@echo "Promote:  cp Makefile.stub Makefile   (or: make -f Makefile.stub promote)"
	@echo "OSS:      make start / make stop  → projects/sample-landing-llm"
	@echo "Lab:      cd ../guidify-lab && make start  (private multi-host stack)"

promote:
	@if [ -f "$(ROOT)/Makefile" ]; then \
		echo "Makefile already exists — leave it alone"; \
	else \
		cp "$(ROOT)/Makefile.stub" "$(ROOT)/Makefile"; \
		echo "Created Makefile from Makefile.stub (gitignored)"; \
	fi

build:
	cd "$(ROOT)" && yarn install && yarn build

start: start-vapi-studio

stop:
	@cd "$(ROOT)/projects/sample-landing-llm" && docker compose down 2>/dev/null || true
	@echo ">> stopped"

reset:
	@echo "reset for the multi-host lab is in ../guidify-lab (make reset)" >&2
	@exit 1

start-vapi-studio: build
	cd "$(ROOT)/projects/sample-landing-llm" && yarn start
